generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum CodingPlatform {
  LEETCODE
  GEEKSFORGEEKS
  CODECHEF
  ATCODER
  CODEFORCES
  HACKERRANK
  HACKEREARTH
  CODESTUDIO
  INTERVIEWBIT
  CUSTOM
}

model Company {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  problems          CompanyProblem[]
  userTargets       UserTargetCompany[]
  communityProblems CommunityProblem[]
}

model Problem {
  id          Int        @id @default(autoincrement())
  leetcodeId  String     @unique
  title       String
  slug        String     @unique
  difficulty  Difficulty
  leetcodeUrl String     @unique
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  companies  CompanyProblem[]
  topics     ProblemTopic[]
  userSolved UserSolvedProblem[]

  @@index([difficulty])
}

model CompanyProblem {
  id        Int      @id @default(autoincrement())
  companyId Int
  problemId Int
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([companyId, problemId])
  @@index([problemId])
}

model Topic {
  id       Int            @id @default(autoincrement())
  name     String         @unique
  problems ProblemTopic[]

  createdAt DateTime @default(now())
}

model ProblemTopic {
  id        Int      @id @default(autoincrement())
  problemId Int
  topicId   Int
  createdAt DateTime @default(now())

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  topic   Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([problemId, topicId])
  @@index([topicId])
}

model User {
  id          String   @id // Firebase UID
  email       String?  @unique
  phoneNumber String?  @unique
  displayName String?
  photoUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  targets     UserTargetCompany[]
  solved      UserSolvedProblem[]
  submissions CommunityProblem[]
}

model UserTargetCompany {
  id        Int      @id @default(autoincrement())
  userId    String
  companyId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([userId])
}

model UserSolvedProblem {
  id        Int      @id @default(autoincrement())
  userId    String
  problemId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@index([userId])
}

model CommunityProblem {
  id          Int            @id @default(autoincrement())
  companyId   Int
  userId      String?
  platform    CodingPlatform @default(LEETCODE)
  title       String
  problemUrl  String?
  difficulty  Difficulty     @default(MEDIUM)
  roundType   String
  topics      String[]
  notes       String?
  upvotes     Int            @default(1)
  createdAt   DateTime       @default(now())

  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user        User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([createdAt])
}

